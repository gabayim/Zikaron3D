# Copy to .env for local builds. Production values belong in EAS environment
# variables for the production profile, not in this file and not in git.
# Never put a Supabase service_role key here. The app only uses the anon key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
EXPO_PUBLIC_SITE_URL=https://zmz.ca/zikaron3d
APP_VARIANT=development

# Server-side secrets (Supabase Edge Function secrets, never in this file):
#   REVENUECAT_WEBHOOK_SECRET, APPLE_CLIENT_ID, APPLE_CLIENT_SECRET
